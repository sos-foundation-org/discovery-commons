datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth required tables
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Domain models

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  emailVerified      DateTime? @map("email_verified")
  name               String?
  displayName        String?   @map("display_name")
  image              String?
  trustLevel         String    @default("new_member") @map("trust_level")
  covenantAcceptedAt DateTime? @map("covenant_accepted_at")
  bio                String?
  interests          Json      @default("[]")
  // v2: ORCID identity linking (Phase 2 — Task 4)
  orcidId            String?   @unique @map("orcid_id")
  orcidVerified      Boolean   @default(false) @map("orcid_verified")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  accounts            Account[]
  sessions            Session[]
  threads             Thread[]
  contributions       Contribution[]
  comments            Comment[]
  sealedRegistrations SealedRegistration[]
  credits             Credit[]
  creditsV2           CreditV2[]           @relation("UserCreditsV2")
  aiInteractions      AIInteraction[]
  trustedByMe         TrustedCircle[]      @relation("owner")
  trustedByOthers     TrustedCircle[]      @relation("trusted")
  notifications       Notification[]
  visibilityChanges   VisibilityLog[]
  threadCollaborations ThreadCollaborator[]
  contributionShares  ContributionShare[]

  @@map("users")
}

model Thread {
  id           String   @id @default(uuid())
  creatorId    String   @map("creator_id")
  title        String
  description  String
  visibility   String   @default("private")
  currentStage String   @default("question") @map("current_stage")
  // Top-level discipline (DISCIPLINE_CONFIG key) — colored badge in the UI.
  discipline   String?
  domainTags   Json     @default("[]") @map("domain_tags")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isArchived   Boolean  @default(false) @map("is_archived")
  // v2: Verify-based science (Task 3) — unverified | ai_checked | community_reviewed | replicated | doi_published
  verificationBadge String @default("unverified") @map("verification_badge")
  doi          String?  @unique

  creator       User           @relation(fields: [creatorId], references: [id])
  contributions Contribution[]
  credits       Credit[]
  creditsV2     CreditV2[]
  collaborators ThreadCollaborator[]
  researchObject ResearchObject?
  replicationsOf Replication[]  @relation("OriginalThread")
  replicatedIn   Replication[]  @relation("ReplicationThread")

  @@index([visibility])
  @@index([createdAt])
  @@map("threads")
}

model Contribution {
  id          String   @id @default(uuid())
  threadId    String   @map("thread_id")
  authorId    String   @map("author_id")
  type        String
  content     String
  contentHash String   @map("content_hash")
  visibility  String   @default("private")
  // Seal lifecycle (Web Prototype §3A): visibility="sealed" hides content while
  // exposing contentHash + serverTimestamp. sealedAt/revealedAt are the audit trail.
  sealedAt    DateTime? @map("sealed_at")
  revealedAt  DateTime? @map("revealed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  parentId    String?  @map("parent_id")
  attachments Json     @default("[]")
  // Structured extras per type — e.g. Method: { methodAppliesTo: ["analysis"] }
  metadata    Json?
  // v2: replication metadata (Task 2) — { originalThreadId, outcome }
  replicationMeta Json? @map("replication_meta")

  thread   Thread        @relation(fields: [threadId], references: [id])
  author   User          @relation(fields: [authorId], references: [id])
  parent   Contribution? @relation("ContributionTree", fields: [parentId], references: [id])
  children Contribution[] @relation("ContributionTree")

  versions   ContributionVersion[]
  comments   Comment[]
  credits    Credit[]
  creditsV2  CreditV2[]
  sealedReg  SealedRegistration?
  sharedWith ContributionShare[]

  @@index([threadId])
  @@index([authorId])
  @@index([contentHash])
  @@map("contributions")
}

model ContributionVersion {
  id             String   @id @default(uuid())
  contributionId String   @map("contribution_id")
  versionNumber  Int      @map("version_number")
  content        String
  contentHash    String   @map("content_hash")
  editSummary    String?  @map("edit_summary")
  createdAt      DateTime @default(now()) @map("created_at")

  contribution Contribution @relation(fields: [contributionId], references: [id])

  @@unique([contributionId, versionNumber])
  @@index([contentHash])
  @@map("contribution_versions")
}

model SealedRegistration {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  contentHash    String    @map("content_hash")
  title          String?
  registeredAt   DateTime  @default(now()) @map("registered_at")
  revealedAt     DateTime? @map("revealed_at")
  contributionId String?   @unique @map("contribution_id")
  status         String    @default("sealed")

  user         User          @relation(fields: [userId], references: [id])
  contribution Contribution? @relation(fields: [contributionId], references: [id])

  @@index([userId])
  @@index([contentHash])
  @@map("sealed_registrations")
}

model Comment {
  id             String   @id @default(uuid())
  contributionId String   @map("contribution_id")
  authorId       String   @map("author_id")
  content        String
  commentType    String   @default("supportive") @map("comment_type")
  isAnonymous    Boolean  @default(false) @map("is_anonymous")
  parentId       String?  @map("parent_id")
  upvotes        Int      @default(0)
  downvotes      Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  contribution Contribution @relation(fields: [contributionId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
  parent       Comment?     @relation("CommentTree", fields: [parentId], references: [id])
  children     Comment[]    @relation("CommentTree")

  @@index([contributionId])
  @@map("comments")
}

model Credit {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  threadId       String   @map("thread_id")
  contributionId String?  @map("contribution_id")
  creditType     String   @map("credit_type")
  hash           String
  timestamp      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  thread       Thread        @relation(fields: [threadId], references: [id])
  contribution Contribution? @relation(fields: [contributionId], references: [id])

  @@index([userId])
  @@map("credits")
}

model TrustedCircle {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  trustedUserId String   @map("trusted_user_id")
  addedAt       DateTime @default(now()) @map("added_at")
  note          String?

  owner       User @relation("owner", fields: [ownerId], references: [id])
  trustedUser User @relation("trusted", fields: [trustedUserId], references: [id])

  @@unique([ownerId, trustedUserId])
  @@map("trusted_circles")
}

// Thread-scoped collaborators (Web Prototype §3A.4). Distinct from the
// user-level TrustedCircle: membership is per-thread and grants access to
// "shared" threads and their shared contributions.
model ThreadCollaborator {
  id       String   @id @default(uuid())
  threadId String   @map("thread_id")
  userId   String   @map("user_id")
  role     String   @default("viewer") // viewer | contributor | admin
  addedAt  DateTime @default(now()) @map("added_at")
  addedBy  String   @map("added_by") // userId of inviter (audit field, no FK)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_collaborators")
}

// Per-contribution extra viewers (Web Prototype §3A.4). Lets a "shared"
// contribution be revealed to specific users beyond thread collaborators.
model ContributionShare {
  id             String   @id @default(uuid())
  contributionId String   @map("contribution_id")
  userId         String   @map("user_id")
  sharedAt       DateTime @default(now()) @map("shared_at")
  sharedBy       String   @map("shared_by") // userId of sharer (audit field, no FK)

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([contributionId, userId])
  @@index([userId])
  @@map("contribution_shares")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  linkUrl   String?  @map("link_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model VisibilityLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldLevel   String   @map("old_level")
  newLevel   String   @map("new_level")
  changedBy  String   @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")

  user User @relation(fields: [changedBy], references: [id])

  @@index([entityType, entityId])
  @@map("visibility_logs")
}

// ============================================================
// v2 — Phase 2 models (DC_Claude_Code_Brief Tasks 1, 3, 5, 6)
// ============================================================

// Task 1: Nine-dimensional credit system.
// Append-only: hash and timestamp are never updated. Weight adjustments
// create a NEW record with an incremented version (enforced in app code —
// SQLite has no UPDATE triggers, unlike the PostgreSQL plan in the brief).
model CreditV2 {
  id              String   @id @default(uuid())
  contributorId   String   @map("contributor_id")
  threadId        String   @map("thread_id")
  contributionId  String?  @map("contribution_id")
  creditType      String   @map("credit_type")
  // idea | data | method | analysis | validation | communication | curation | resource | mentorship
  weight          Float    @default(0.0)
  hash            String // SHA-256 of (contributorId + creditType + contributionId + timestamp)
  timestamp       DateTime @default(now())
  // JSON array of parent CreditV2 ids (SQLite has no scalar lists)
  parentCreditIds Json     @default("[]") @map("parent_credit_ids")
  version         Int      @default(1)

  contributor  User          @relation("UserCreditsV2", fields: [contributorId], references: [id])
  thread       Thread        @relation(fields: [threadId], references: [id])
  contribution Contribution? @relation(fields: [contributionId], references: [id])

  @@index([contributorId])
  @@index([threadId])
  @@index([creditType])
  @@map("credits_v2")
}

// Task 3: Replication records for Verify-based Science.
model Replication {
  id                  String   @id @default(uuid())
  originalThreadId    String   @map("original_thread_id")
  replicationThreadId String   @map("replication_thread_id")
  outcome             String // replicated | partially_replicated | failed_to_replicate | inconclusive
  notes               String?
  contributionId      String?  @map("contribution_id") // the replication contribution
  createdAt           DateTime @default(now()) @map("created_at")

  originalThread    Thread @relation("OriginalThread", fields: [originalThreadId], references: [id])
  replicationThread Thread @relation("ReplicationThread", fields: [replicationThreadId], references: [id])

  @@index([originalThreadId])
  @@index([replicationThreadId])
  @@map("replications")
}

// Task 5: AI interaction log (cost tracking + structured outputs).
model AIInteraction {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  threadId     String?  @map("thread_id")
  aiRole       String   @map("ai_role") // research_assistant | reviewer | translator
  aiFeature    String   @map("ai_feature") // gap_analysis | literature | error_check | bias_detect | summarize | ...
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  cost         Float // calculated from token counts
  cached       Boolean  @default(false)
  responseData Json?    @map("response_data") // structured AI output
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([threadId])
  @@map("ai_interactions")
}

// Task 6: Research Object — Semantic Document Graph (SDG) storage.
model ResearchObject {
  id                String   @id @default(uuid())
  threadId          String   @unique @map("thread_id")
  structuredContent Json     @map("structured_content") // SemanticDocumentGraph JSON
  version           Int      @default(1)
  doiId             String?  @unique @map("doi_id")
  // Cache of rendered outputs keyed by format ({} default set in app code —
  // SQLite rejects a literal `{}` column default).
  renderedFormats   Json?    @map("rendered_formats")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  thread Thread @relation(fields: [threadId], references: [id])

  @@map("research_objects")
}
