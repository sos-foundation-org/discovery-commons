# Database (PostgreSQL via Supabase or local Docker)
DATABASE_URL="postgresql://dc_dev:dc_dev_password@localhost:5432/discovery_commons"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Claude API (Phase 2 — powers the AI Reviewer)
ANTHROPIC_API_KEY=""
# Model used by AI features (defaults to claude-opus-4-8)
AI_MODEL="claude-opus-4-8"

# AI cost controls (Phase 2)
AI_MONTHLY_BUDGET_CEILING="100"
AI_PER_USER_DAILY_QUOTA="10"
AI_REVIEWER_DAILY_QUOTA="5"

# ORCID OAuth (Phase 2 — Task 4). Leave blank to disable the ORCID provider.
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_SANDBOX="true"  # use sandbox.orcid.org for development

# External APIs (Phase 3+, not needed yet)
# DATACITE_API_URL=""
# DATACITE_USERNAME=""
# DATACITE_PASSWORD=""
# DATACITE_PREFIX=""

# Redis (optional — falls back to in-memory)
REDIS_URL=""
