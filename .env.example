# ============================================================================
# Discovery Commons — environment variables
# ============================================================================
# Local dev uses SQLite (no Docker/Postgres needed). Production uses Supabase
# PostgreSQL. The `provider` in prisma is swapped at build time by
# scripts/prisma-provider.mjs based on DATABASE_PROVIDER (see DEPLOY.md).

# ---- Database ----
# LOCAL (default): SQLite file. Leave DATABASE_PROVIDER unset.
DATABASE_URL="file:./dev.db"
# DATABASE_PROVIDER="sqlite"   # optional locally; "postgresql" on Vercel

# PRODUCTION (Supabase): set these in the Vercel project env instead —
#   DATABASE_PROVIDER="postgresql"
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require"
#   (use the Supabase "Connection string" → "URI"; the pooled 6543 port for the app,
#    the direct 5432 port for `prisma db push` / migrations)

# ---- Supabase (used by the keepalive action + any future Supabase client) ----
NEXT_PUBLIC_SUPABASE_URL=""          # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=""     # public anon key
# SUPABASE_SERVICE_ROLE_KEY=""       # server-only; not required by the current app

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"          # https://<app>.vercel.app in prod
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ---- Google OAuth (primary; basic scopes, production mode — no 7-day limit) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- GitHub OAuth (optional secondary) ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================================================
# Everything below is Phase 2 / production-only. Leave blank for the prototype.
# ============================================================================

# Claude API (Phase 2 — powers the AI Reviewer). Deferred for the prototype.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"
AI_MONTHLY_BUDGET_CEILING="100"
AI_PER_USER_DAILY_QUOTA="10"
AI_REVIEWER_DAILY_QUOTA="5"

# ORCID OAuth (Phase 2). Leave blank to disable the ORCID provider.
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_SANDBOX="true"

# External APIs (Phase 3+, not needed yet)
# DATACITE_API_URL=""
# DATACITE_USERNAME=""
# DATACITE_PASSWORD=""
# DATACITE_PREFIX=""

# Redis (optional — falls back to in-memory)
REDIS_URL=""
